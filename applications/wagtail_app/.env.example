# Django/Wagtail settings
DJANGO_SETTINGS_MODULE=PROJECT_NAME.settings.production
SECRET_KEY=your-very-secret-key
DEBUG=0
ALLOWED_HOSTS=your.domain.com,localhost

# Database (example for PostgreSQL)
POSTGRES_DB=PLACEHOLDER_DB_NAME
POSTGRES_USER=PLACEHOLDER_DB_USER
POSTGRES_PASSWORD=PLACEHOLDER_DB_PASS
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis (for Celery broker and Wagtail cache)
REDIS_PASSWORD=your_redis_password
CELERY_BROKER_URL=redis://:your_redis_password@redis:6379/0

# Wagtail settings
WAGTAIL_SITE_NAME=PROJECT_NAME

# (Optional) Email, cache, or other Django/Wagtail environment variables can go here
